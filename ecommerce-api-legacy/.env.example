# Porta HTTP
PORT=3000
# Arquivo SQLite (":memory:" = banco em memória recriado a cada boot)
DB_FILE=:memory:
# Chave do gateway de pagamento (obrigatória em produção)
PAYMENT_GATEWAY_KEY=pk_test_changeme
# Token exigido no header X-Admin-Token para /api/admin/* e DELETE /api/users/:id
ADMIN_TOKEN=changeme
# Senha do usuário de seed (apenas desenvolvimento)
SEED_USER_PASSWORD=changeme
