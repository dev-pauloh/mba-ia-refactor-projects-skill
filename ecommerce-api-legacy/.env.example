# Porta HTTP (padrão 3000)
PORT=3000
# Arquivo SQLite; ":memory:" recria o banco (com seed) a cada boot
DB_FILE=:memory:
# Nível de log: error | warn | info | debug
LOG_LEVEL=info
# Chave do gateway de pagamento (nunca versionar o valor real)
PAYMENT_GATEWAY_KEY=
# Token exigido em "Authorization: Bearer <token>" nas rotas administrativas.
# Sem valor, GET /api/admin/financial-report e DELETE /api/users/:id respondem 401.
ADMIN_API_TOKEN=
