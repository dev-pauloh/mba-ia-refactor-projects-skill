# Chave para assinar os tokens de acesso. Obrigatória em produção;
# se ausente, uma chave aleatória é gerada a cada boot (tokens deixam de valer ao reiniciar).
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Validade do token de acesso, em segundos
TOKEN_MAX_AGE=3600

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Caminho do banco SQLite
DATABASE_PATH=loja.db

# Origens permitidas para CORS, separadas por vírgula (vazio = CORS desabilitado)
CORS_ORIGINS=

# Habilita POST /admin/query (somente SELECT, conexão somente leitura, apenas admin)
ENABLE_ADMIN_SQL=false
