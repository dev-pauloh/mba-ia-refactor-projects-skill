# Chave de assinatura do Flask. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Token exigido no header X-Admin-Token para /admin/* e /relatorios/vendas (vazio = rotas bloqueadas)
ADMIN_TOKEN=
# Habilita POST /admin/query (execução de SQL arbitrário). Mantenha false em produção.
ENABLE_ADMIN_SQL=false
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
APP_ENV=development
DATABASE_PATH=loja.db
# Origens permitidas para CORS, separadas por vírgula (vazio = CORS desabilitado)
CORS_ORIGINS=
LOG_LEVEL=INFO
