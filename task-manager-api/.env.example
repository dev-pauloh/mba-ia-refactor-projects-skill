# Chave de assinatura dos tokens (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Origens permitidas para CORS, separadas por vírgula (vazio = CORS desabilitado)
CORS_ORIGINS=http://localhost:3000
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600
# SMTP para notificações (SMTP_HOST vazio = notificações só registradas em log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
