# Copie para .env e ajuste. Nunca versione o .env com valores reais.

# Chave de assinatura dos tokens de acesso (obrigatória em produção).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco de dados (SQLAlchemy URI). O padrão cria instance/tasks.db.
DATABASE_URL=sqlite:///tasks.db

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Origens permitidas para CORS, separadas por vírgula (vazio = nenhuma origem cruzada)
CORS_ORIGINS=

# Validade do token de acesso, em segundos (padrão: 8 horas)
TOKEN_MAX_AGE=28800

# SMTP do serviço de notificações (vazio = e-mails não são enviados, apenas logados)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
