# Copie para .env e ajuste. Nunca versione o .env real.

# Chave de assinatura dos tokens de login (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-um-valor-aleatorio
DATABASE_URL=sqlite:///tasks.db

FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Origens autorizadas para CORS, separadas por vírgula (vazio = nenhuma origem externa)
CORS_ORIGINS=http://localhost:3000

# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600

# SMTP das notificações (SMTP_HOST vazio = notificações apenas registradas em log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
