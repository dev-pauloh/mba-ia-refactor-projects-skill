# Porta padrão do projeto. Para rodar junto com o code-smells-project (também 5000),
# suba com PORT=5001 python app.py e troque a linha abaixo para 5001.
@baseUrl = http://localhost:5000

# Rotas marcadas com exigem token. Execute primeiro o "Login como admin" abaixo.

### Login como admin (execute primeiro — o token é usado nas rotas [auth])
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "joao@email.com",
  "password": "joao1234"
}


### Índice da API
GET {{baseUrl}}/

### Health
GET {{baseUrl}}/health

# ---------------------------------------------------------------- Tasks

### Listar tasks (com user_name/category_name, sem N+1) [auth]
GET {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.token}}

### Buscar task por id [auth]
GET {{baseUrl}}/tasks/1
Authorization: Bearer {{login.response.body.token}}

### Task inexistente → 404 [auth]
GET {{baseUrl}}/tasks/999
Authorization: Bearer {{login.response.body.token}}

### Pesquisar tasks [auth]
GET {{baseUrl}}/tasks/search?q=a&status=pending
Authorization: Bearer {{login.response.body.token}}

### Pesquisa com prioridade inválida → 400 (antes: 500) [auth]
GET {{baseUrl}}/tasks/search?priority=alta
Authorization: Bearer {{login.response.body.token}}

### Estatísticas [auth]
GET {{baseUrl}}/tasks/stats
Authorization: Bearer {{login.response.body.token}}

### Criar task → 201 [auth]
POST {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Estudar Claude Code Skills",
  "description": "Desafio do MBA",
  "priority": 1,
  "user_id": 1,
  "category_id": 1,
  "due_date": "2026-10-10",
  "tags": ["mba", "ia"]
}

### Criar task com prioridade inválida → 400 (antes: 500) [auth]
POST {{baseUrl}}/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Teste",
  "priority": "alta"
}

### Atualizar task [auth]
PUT {{baseUrl}}/tasks/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "in_progress",
  "priority": 2
}

### Deletar task [auth]
DELETE {{baseUrl}}/tasks/2
Authorization: Bearer {{login.response.body.token}}

# ---------------------------------------------------------------- Usuários

### Listar usuários [auth]
GET {{baseUrl}}/users
Authorization: Bearer {{login.response.body.token}}

### Buscar usuário (sem o hash da senha) [auth]
GET {{baseUrl}}/users/2
Authorization: Bearer {{login.response.body.token}}

### Tasks de um usuário [auth]
GET {{baseUrl}}/users/2/tasks
Authorization: Bearer {{login.response.body.token}}

### Criar usuário comum → 201 [auth]
POST {{baseUrl}}/users
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Ana Souza",
  "email": "ana@email.com",
  "password": "senhaforte"
}

### Criar usuário sem token → 401 (antes: qualquer um criava até admin)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Intruso",
  "email": "intruso@email.com",
  "password": "senhaforte",
  "role": "admin"
}

### Atualizar nome do usuário [auth]
PUT {{baseUrl}}/users/2
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Maria S."
}

### Deletar usuário sem token → 401
DELETE {{baseUrl}}/users/3

### Deletar usuário com token de admin → 200 [auth]
DELETE {{baseUrl}}/users/3
Authorization: Bearer {{login.response.body.token}}

# ---------------------------------------------------------------- Relatórios e categorias

### Relatório geral [auth]
GET {{baseUrl}}/reports/summary
Authorization: Bearer {{login.response.body.token}}

### Relatório por usuário [auth]
GET {{baseUrl}}/reports/user/1
Authorization: Bearer {{login.response.body.token}}

### Listar categorias (com task_count) [auth]
GET {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.token}}

### Criar categoria [auth]
POST {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Estudos",
  "description": "Tarefas do MBA",
  "color": "#8e44ad"
}

### Criar categoria com cor inválida → 400 [auth]
POST {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Errada",
  "color": "vermelho"
}

### Atualizar categoria [auth]
PUT {{baseUrl}}/categories/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Backend & APIs"
}

### Deletar categoria (tasks ficam sem categoria, não órfãs) [auth]
DELETE {{baseUrl}}/categories/4
Authorization: Bearer {{login.response.body.token}}
